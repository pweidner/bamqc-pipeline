# Snakemake internals
.snakemake/
*/.snakemake/

# Pipeline logs and errors
logs/
*/logs/
errors/
*/errors/

# Scheduler and cluster outputs
# (SLURM, SGE, PBS, etc.)
*.out
*.err
*.error
*.o[0-9]*
*.e[0-9]*
slurm-*.out
pbs*.o[0-9]*

# Large, raw, and derived data
# Do not track FASTQ, BAM, VCF, etc.
*.fastq
*.fq
*.fastq.gz
*.fq.gz
*.sam
*.bam
*.bam.bai
*.vcf
*.vcf.gz

# Local private configuration
config/config.local.yaml
config/*.local.yaml

# Python and Conda caches
__pycache__/
*.py[cod]
*$py.class
.conda/
.venv/

# OS and editor temporary files
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/
