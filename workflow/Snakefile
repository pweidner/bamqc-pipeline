        set -euo pipefail
        mkdir -p {params.qc2_dir} {params.log_dir}
        python -u workflow/scripts/qc_from_counts.py \
          --counts {input.tsv} \
          --sample {wildcards.sample} \
          --gc-table {input.gc} \
          --preseq {input.preseq} \
          --out {output.qc} > {log} 2>&1
        """

