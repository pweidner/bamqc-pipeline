# Snakefile
configfile: "config/config.yaml"

# =========================== Imports & helpers ============================
import os, sys, re
from pathlib import Path

LOCAL_CONFIG = "config/config.local.yaml"
if os.path.exists(LOCAL_CONFIG):
    configfile: LOCAL_CONFIG

def _bool(x, default=False):
    if x is None:
        return default
    if isinstance(x, bool):
        return x
    return str(x).lower() in ("1","true","yes","y","on")

def sanitize_suffix(x, default):
    if x is None:
        x = default
    x = str(x)
    # normalize Unicode whitespace (incl NBSP) and remove *all* whitespace
    x = x.replace("\u00A0", " ")
    x = re.sub(r"\s+", "", x)
    return x

def expand_path(value, default=None):
    if value is None:
        value = default
    if value is None:
        return None
    return os.path.expandvars(os.path.expanduser(str(value)))

def abs_path(value, default=None):
    expanded = expand_path(value, default=default)
    if expanded is None:
        return None
    return Path(expanded).resolve()

def parse_chromosomes(value):
    """Parse config chromosomes like '1-22,X,Y', ['1', '2'], or 'all'."""
    if value is None:
        value = "1-22,X,Y"
    if isinstance(value, str):
        if value.strip().lower() in ("all", "*", "none", ""):
            return []
        tokens = [x.strip() for x in value.split(",") if x.strip()]
    else:
        tokens = [str(x).strip() for x in value if str(x).strip()]

    chroms = []
    for token in tokens:
        if re.fullmatch(r"\d+\s*-\s*\d+", token):
            start, end = [int(x) for x in re.split(r"\s*-\s*", token)]
            step = 1 if start <= end else -1
            chroms.extend(str(i) for i in range(start, end + step, step))
        else:
            chroms.append(token)
    return chroms

def infer_sample_from_library(library_id):
    m = re.match(r"(.+?)_A\d+_L\d+_i\d+.*$", library_id)
    if m:
        return m.group(1)
    return library_id.split("_", 1)[0] if "_" in library_id else library_id

def find_bam_index(bam):
    candidates = [bam + ".bai"]
    if bam.endswith(".bam"):
        candidates.append(bam[:-4] + ".bai")
    for candidate in candidates:
        if os.path.exists(candidate):
            return candidate
    return None

