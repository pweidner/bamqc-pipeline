ASH["model_path"] = expand_path(ASH.get("model_path", ""))
ASH_ENABLED = _bool(ASH.get("enabled", True))

# -------------------------- Discover BAMs (FLAT / HIER via find) --------------------------
def discover_bams(root: Path, bam_ext: str):
    """
    Use POSIX 'find' (safe quoting via subprocess) and construct pattern
    with explicit string concatenation: pattern = "*" + bam_ext
    """
    import subprocess

    def strip_bam_suffix(name: str) -> str:
        return name[:-4] if name.endswith(".bam") else name

    def run_find(path: str, maxdepth: int, name_pattern: str):
        cmd = ["find", path, "-maxdepth", str(maxdepth), "-type", "f", "-name", name_pattern]
        try:
            proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
        except Exception as e:
            print("[discover_bams] find failed for " + path + ": " + str(e), file=sys.stderr)
            return []
        if proc.stderr and proc.stderr.strip():
            print("[discover_bams] find stderr: " + proc.stderr.strip(), file=sys.stderr)
        return [Path(x) for x in proc.stdout.splitlines() if x.strip()]

    if not root.exists():
        print("[ERROR] data_location does not exist: " + str(root), file=sys.stderr)
        return None, {}, {}

    be = str(bam_ext or "").strip()
    if be == "":
        print("[discover_bams] Warning: bam_ext empty; defaulting to '.sort.mdup.bam'", file=sys.stderr)
        be = ".sort.mdup.bam"

    pattern = "*" + be  # safe, no whitespace between * and ext

    # FLAT search (maxdepth 1)
    flat = run_find(str(root), maxdepth=1, name_pattern=pattern)
    if flat:
        mode = "FLAT"
        bam_of = {}
        sample_of = {}
        for p in sorted(flat):
            sid = strip_bam_suffix(p.name)
            bam_of[sid] = str(p.resolve())
            sample_of[sid] = infer_sample_from_library(sid)
        print("[discover_bams] FLAT: found " + str(len(bam_of)) + " bams under " + str(root), file=sys.stderr)
        return mode, bam_of, sample_of

    # HIER search (child/<bam> directories)
    mode = "HIER"
    bam_of = {}
    sample_of = {}
    for child in sorted(p for p in root.iterdir() if p.is_dir()):
        bamdir = child / "bam"
        if not bamdir.is_dir():
            continue
        found = run_find(str(bamdir), maxdepth=1, name_pattern=pattern)
        if not found:
            continue
        for p in sorted(found):
            bam_base = strip_bam_suffix(p.name)
            sid = child.name + "_" + bam_base
            if sid in bam_of:
                print("[WARN] Duplicate library ID " + sid + " (old: " + bam_of[sid] + " new: " + str(p) + ")", file=sys.stderr)
            bam_of[sid] = str(p.resolve())
            sample_of[sid] = child.name

    if bam_of:
        return mode, bam_of, sample_of

    print("[ERROR] No BAMs found under " + str(root) + ". Looked for '*" + be + "' in FLAT mode or '*/bam/*" + be + "'", file=sys.stderr)
    return None, {}, {}

def discover_sctrip_counts_info(root: Path, mode: str):
    """Find mosaicatcher/scTRIP counts info files for HIER inputs.

    Prefer sample-level *.info_raw tables because they retain all cells. Fall back
    to *.info only for older runs without raw tables.
    """
    if mode != "HIER" or not root.exists():
        return []
    paths = []
    for child in sorted(p for p in root.iterdir() if p.is_dir()):
        counts_dir = child / "counts"
        if not counts_dir.is_dir():
            continue
        raw = sorted(counts_dir.glob("*.info_raw"))
        fallback = sorted(counts_dir.glob("*.info"))
        paths.extend(str(p.resolve()) for p in (raw if raw else fallback))
    return paths

MODE, BAM_OF, SAMPLE_OF = discover_bams(DATA_ROOT, BAM_EXT)
SAMPLES = sorted(BAM_OF.keys())
