    "enabled": True,
    "bin": "",
    "model_path": "",
    "win_sizes": [5_000_000, 2_000_000, 1_000_000, 800_000, 600_000, 400_000, 200_000],
    "threads": 32,
    "mem_mb": 200000,
    "conda_env": "envs/ashleys.yaml",
}
