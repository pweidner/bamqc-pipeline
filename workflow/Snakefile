# ---------------------------- Output structure ----------------------------
def out_path(*parts):
    return str(OUT_ROOT.joinpath(*parts))

DIR_LOGS   = out_path("logs")
DIR_STATS  = out_path("stats-by-lib")
DIR_BINS   = out_path("binned")
DIR_QC2    = out_path("qc-from-bins")
DIR_PRESEQ = out_path("preseq")
DIR_PLOTS  = out_path("plots")

WIN_BED_GZ = out_path("windows_" + str(WIN_SIZE) + ".bed.gz")
WIN_GC_GZ  = out_path("windows_" + str(WIN_SIZE) + ".gc.tsv.gz")

# Ashley
